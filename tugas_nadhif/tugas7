    <script>
        // Fitur Mode Gelap & Terang (Dark / Light Theme Toggle)
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeIcon = document.getElementById('themeIcon');
        const currentTheme = localStorage.getItem('petik_theme');

        function setTheme(isDark) {
            if (isDark) {
                document.body.classList.add('dark-mode');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
                localStorage.setItem('petik_theme', 'dark');
            } else {
                document.body.classList.remove('dark-mode');
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
                localStorage.setItem('petik_theme', 'light');
            }
        }

        // Cek preferensi sebelumnya atau sistem
        if (currentTheme === 'dark' || (!currentTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            setTheme(true);
        } else {
            setTheme(false);
        }

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                const isDarkMode = document.body.classList.contains('dark-mode');
                setTheme(!isDarkMode);
            });
        }

        // Toggle Menu Hamburger di Layar Mobile
        const menuBtn = document.getElementById('mobileMenuBtn');
        const navPanel = document.getElementById('mobileNavPanel');

        if (menuBtn && navPanel) {
            menuBtn.addEventListener('click', () => {
                navPanel.classList.toggle('open');
                const isOpen = navPanel.classList.contains('open');
                menuBtn.innerHTML = isOpen ? '<i class="fa-solid fa-xmark"></i>' : '<i class="fa-solid fa-bars"></i>';
            });
        }

        // Smooth Scroll untuk Anchor Links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                const targetId = this.getAttribute('href');
                if (targetId && targetId !== '#') {
                    const targetEl = document.querySelector(targetId);
                    if (targetEl) {
                        e.preventDefault();
                        targetEl.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            });
        });
    </script>
