//luas Segitiga//
function hitungLuasSegitiga(alas, tinggi) {
    let luas = (alas * tinggi) / 2;
    return luas;
}
let nilaiAlas = 10;
let nilaiTinggi = 8;
let hasil = hitungLuasSegitiga(nilaiAlas, nilaiTinggi);
console.log("Luas segitiga dengan alas " + nilaiAlas + " dan tinggi " + nilaiTinggi + " adalah: " + hasil);

