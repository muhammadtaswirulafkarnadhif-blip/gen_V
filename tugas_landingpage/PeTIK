    <!-- JavaScript Interaktif -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            
            // 0. Theme Toggle Logic
            const themeToggleBtn = document.getElementById('theme-toggle');
            
            themeToggleBtn.addEventListener('click', function() {
                if (document.documentElement.classList.contains('dark')) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            });

            // 1. Typing Effect Logic
            const textToType = "Pesantren yang Melahirkan Santri dengan Kemampuan IT";
            const typingElement = document.getElementById("typing-text");
            let index = 0;

            function type() {
                if (index < textToType.length) {
                    typingElement.innerHTML += textToType.charAt(index);
                    index++;
                    // Variasi kecepatan ketik sedikit untuk realistis
                    let typeSpeed = Math.random() * (100 - 50) + 50; 
                    setTimeout(type, typeSpeed);
                }
            }
            
            // Mulai ngetik setelah delay dikit
            setTimeout(type, 800);

            // 2. IntersectionObserver (Scroll Reveal)
            const revealElements = document.querySelectorAll(".reveal");
            
            const revealOptions = {
                threshold: 0.15, // Muncul ketika 15% elemen terlihat
                rootMargin: "0px 0px -50px 0px" // Trigger agak ke atas dari bawah layar
            };

            const revealOnScroll = new IntersectionObserver(function(entries, observer) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                    }
                });
            }, revealOptions);

            revealElements.forEach(el => {
                revealOnScroll.observe(el);
            });

            // 3. Navbar scroll effect (tambah bayangan saat turun)
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 20) {
                    navbar.classList.add('shadow-md');
                    navbar.classList.add('dark:shadow-brand-cobalt/10');
                    navbar.classList.add('dark:shadow-md');
                } else {
                    navbar.classList.remove('shadow-md');
                    navbar.classList.remove('dark:shadow-brand-cobalt/10');
                    navbar.classList.remove('dark:shadow-md');
                }
            });
        });
    </script>
